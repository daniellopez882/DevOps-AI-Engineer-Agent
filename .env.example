# DevOps OS configuration. Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Inbound: who may POST /webhook -------------------------------------
# GitHub signs deliveries with this secret (X-Hub-Signature-256).
WEBHOOK_SECRET=
# Manual triggers may present this as X-API-Key instead.
API_KEY=
# Production refuses to start with both empty.

# --- Outbound writes ------------------------------------------------------
# ON by default. Tools describe what they would do (comment on GitHub,
# acknowledge/resolve a PagerDuty incident) instead of doing it.
DRY_RUN=true
# Exact owner/name list the GitHub tools may touch. Empty = none.
ALLOWED_REPOS=

# --- Providers --------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GITHUB_TOKEN=
PAGERDUTY_API_KEY=
# PagerDuty rejects status changes without a real user email in From.
PAGERDUTY_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Storage ----------------------------------------------------------------
DATABASE_URL=sqlite:///./devops_os.db
# docker compose reads this for the Postgres service.
POSTGRES_PASSWORD=
